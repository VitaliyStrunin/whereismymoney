# PostgreSQL settings
DB_USER=postgres
DB_PASSWORD=insecure-password-change-me
DB_NAME=expenses_db

# PostgreSQL port on host
POSTGRES_PORT=5433

# Flask API port on host
APP_PORT=8000

# JWT settings
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_TTL_MINUTES=10
JWT_ALGORITHM=HS256

# Refresh tokens settings
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=wimm_refresh_token
REFRESH_TOKEN_SECURE=false
REFRESH_TOKEN_SAMESITE=Lax
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-secret